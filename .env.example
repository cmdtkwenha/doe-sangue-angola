# Doe Sangue Angola
# General example. For a real setup, start from:
# - .env.development.example
# - .env.staging.example
# - .env.production.example
# Mock services stay active unless these values are configured.

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_AUTH_MODE=demo
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_PILOT_MODE=false
NEXT_PUBLIC_PILOT_SAFE_NOTIFICATIONS=true
NEXT_PUBLIC_PUSH_MODE=mock
NEXT_PUBLIC_MONITORING_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_AUTH_MODE=demo
EXPO_PUBLIC_DATA_MODE=mock
EXPO_PUBLIC_PILOT_MODE=false
EXPO_PUBLIC_PILOT_SAFE_NOTIFICATIONS=true
EXPO_PUBLIC_PUSH_MODE=mock
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Future server-only key. Never expose in mobile or browser bundles.
SUPABASE_SERVICE_ROLE_KEY=

# Optional future monitoring.
NEXT_PUBLIC_LOG_LEVEL=info
SENTRY_DSN=
