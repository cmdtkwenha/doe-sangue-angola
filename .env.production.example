# Doe Sangue Angola - Production
# Copy to Vercel/EAS environment variables. Do not commit real values.
# Production points to Supabase and Expo Push; mock mode remains the rollback.

NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_AUTH_MODE=supabase
NEXT_PUBLIC_DATA_MODE=supabase
NEXT_PUBLIC_SITE_URL=https://doesangue.ao
NEXT_PUBLIC_API_URL=https://doesangue.ao
NEXT_PUBLIC_PILOT_MODE=false
NEXT_PUBLIC_PILOT_SAFE_NOTIFICATIONS=true
NEXT_PUBLIC_PUSH_MODE=expo
NEXT_PUBLIC_MONITORING_ENABLED=true
NEXT_PUBLIC_LOG_LEVEL=warn
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_FEATURE_FREEZE=true
NEXT_PUBLIC_FEATURE_REALTIME=true
NEXT_PUBLIC_FEATURE_NOTIFICATIONS=true
NEXT_PUBLIC_FEATURE_MAPS=true
NEXT_PUBLIC_FEATURE_GAMIFICATION=true
NEXT_PUBLIC_FEATURE_EMERGENCY_MODE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_AUTH_MODE=supabase
EXPO_PUBLIC_DATA_MODE=supabase
